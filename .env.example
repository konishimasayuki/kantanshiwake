# Upstash Redis（VercelのUpstash連携を使うと自動で入ります）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ログインセッションの暗号化キー（32文字以上のランダムな文字列）
SESSION_SECRET=

# 最初から用意されるアカウント（未設定なら スーパー管理者 z/z、デモ a/a）
SUPERADMIN_ID=z
SUPERADMIN_PASSWORD=z
DEMO_ID=a
DEMO_PASSWORD=a

# Claude APIキー（任意。管理画面で設定したキーが優先されます）
ANTHROPIC_API_KEY=
